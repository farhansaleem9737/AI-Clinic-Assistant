# Base URL the browser uses for API calls. Relative on purpose: in development
# the Vite dev server proxies /api to the backend (same-origin cookies).
VITE_API_BASE_URL=/api/v1
# Where the dev proxy forwards /api (development only).
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
# Live updates (WebSocket). Leave unset in development (the Vite proxy forwards
# /api/v1/ws). In production set it to the API host directly, because Vercel's
# /api rewrite cannot carry a WebSocket: wss://<your-render-host>/api/v1/ws
# VITE_REALTIME_URL=
# Optional label shown before fees, e.g. PKR or USD.
# VITE_CURRENCY=
# Optional clinic contact details for the Help & Support page. When unset,
# the page tells patients to speak to reception (no invented numbers).
# VITE_SUPPORT_PHONE=
# VITE_SUPPORT_EMAIL=
