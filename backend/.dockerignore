.venv/
venv/
__pycache__/
**/__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
var/
*.log
*.sql

# Not needed at runtime
tests/
scripts/
Dockerfile
.dockerignore
.git
