# Copy to .env and fill in real values. Never commit .env.

# development | staging | production
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/clinic_ai
# Neon: use the pooled endpoint (host contains "-pooler") with ?ssl=require, e.g.
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?ssl=require
# Logs every SQL statement with its parameters. Keep false wherever real data exists.
SQL_ECHO=false

# Connection pool (docs/PERFORMANCE.md). Defaults shown.
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE_SECONDS=240
# DB_PING_AFTER_IDLE_SECONDS=30

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=14
# Session length when "Remember me" is not ticked (cookie also ends with the browser).
SESSION_TOKEN_EXPIRE_HOURS=12
# Refresh cookie gets the Secure flag everywhere except ENVIRONMENT=development.
# Set true/false to override.
# COOKIE_SECURE=

# Comma-separated list of exact frontend origins. "*" is rejected.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# IANA timezone of the clinic: default for new departments and for calendar-date filters.
CLINIC_TIMEZONE=Asia/Karachi

# Appointment booking policy (defaults shown).
# BOOKING_MIN_LEAD_MINUTES=60              # patients cannot book sooner than this; staff can
# BOOKING_MAX_ADVANCE_DAYS=90
# PATIENT_CANCELLATION_CUTOFF_MINUTES=120  # online cancel/reschedule closes this long before start
# NO_SHOW_GRACE_MINUTES=15
# DEFAULT_SLOT_MINUTES=30                  # slot length inside "extra availability" periods
# AVAILABILITY_STATUS_DAYS=7               # window behind the Available/Busy/Unavailable badge

# Appointment and follow-up reminders (docs/NOTIFICATIONS.md). Defaults shown.
# REMINDER_OFFSETS_MINUTES=1440,60         # patients: 24 h and 1 h before
# DOCTOR_REMINDER_OFFSETS_MINUTES=60       # doctors: 1 h before
# FOLLOW_UP_REMINDER_DAYS=7                # a recorded follow-up is mentioned this long before it is due
# Who may call POST /api/v1/internal/reminders/run. Unset = the endpoint does not exist.
# Production (Cloud Scheduler OIDC): the run URL and the scheduler's service account.
# REMINDERS_OIDC_AUDIENCE=https://YOUR-SERVICE-xxxx.a.run.app/api/v1/internal/reminders/run
# REMINDERS_INVOKER_EMAIL=reminder-scheduler@YOUR_PROJECT.iam.gserviceaccount.com
# Development or another scheduler: a shared secret sent as X-Reminders-Secret.
# REMINDERS_CRON_SECRET=

# Notification emails (docs/EMAIL.md): queued in the email_outbox table and sent by the
# reminder run, and right after the event. Defaults shown.
# EMAIL_REMINDER_OFFSETS_MINUTES=1440,60   # which reminders also go by email (among REMINDER_OFFSETS_MINUTES)
# EMAIL_MAX_ATTEMPTS=6
# EMAIL_SEND_AFTER_COMMIT=true
# Implicit TLS (port 465) instead of STARTTLS: SMTP_SSL=true and SMTP_STARTTLS=false.
# SMTP_SSL=false
# Plaintext SMTP is refused, except to a local test server (e.g. Mailpit on localhost:1025):
# SMTP_ALLOW_PLAINTEXT_LOCALHOST=false

# Optional: database used by pytest. Defaults to DATABASE_URL's name + "_test".
# The test suite refuses to run against the DATABASE_URL database itself.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/clinic_ai_test

# Cloudflare R2 file storage (S3-compatible API). Use an R2 API token with
# "Object Read & Write" scoped to this bucket only; its Access Key ID and
# Secret Access Key go below. Use a separate bucket per environment.
R2_ACCOUNT_ID=CHANGE_ME
R2_ENDPOINT_URL=https://CHANGE_ME_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=CHANGE_ME
R2_SECRET_ACCESS_KEY=CHANGE_ME
R2_BUCKET_NAME=clinic-ai-assistant-files
R2_REGION=auto
# Optional tuning (defaults shown).
# R2_TIMEOUT_SECONDS=10
# PHOTO_URL_TTL_SECONDS=3600      # lifetime of presigned profile-photo links
# DOCUMENT_URL_TTL_SECONDS=300    # lifetime of presigned document download links
# MAX_PHOTO_BYTES=5242880         # 5 MB
# MAX_DOCUMENT_BYTES=20971520     # 20 MB

# Doctor self-registration (D77). What an administrator needs before approving
# a doctor application, besides specialization and department. Comma-separated;
# empty = nothing else. Registration itself never requires these.
# Allowed: license_number, registration_authority, years_of_experience, qualifications,
# institution, bio, consultation_fee, languages, phone,
# registration_certificate, degree_certificate, supporting_document
# DOCTOR_APPROVAL_REQUIREMENTS=license_number,registration_certificate

# Optional: Cloudflare REST API token, for bucket administration scripts only.
# Not read by the application.
# CF_API_TOKEN=CHANGE_ME

# Administrator invitations (D87) and every email link (D124) point at the frontend.
# Production: the public https address (http or localhost is refused at start-up).
# Check the SMTP settings without sending: python -m app.cli.email_check [--status]
# FRONTEND_BASE_URL=http://localhost:5173
# ADMIN_INVITE_EXPIRE_HOURS=24
# INVITE_ATTEMPTS_PER_MINUTE=10

# Continue with Google (D123, docs/GOOGLE_SIGN_IN.md). Off unless enabled; then
# the client id and secret (Google Cloud › Google Auth Platform › Clients) are required.
# The callback defaults to FRONTEND_BASE_URL + /api/v1/auth/google/callback and must
# be registered in Google Cloud exactly. Never put the secret in the frontend.
# GOOGLE_OAUTH_ENABLED=true
# GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:5173/api/v1/auth/google/callback

# Outgoing email. Unset = "outbox" in development (messages are written to
# backend/var/outbox/*.eml, never logged), otherwise smtp when SMTP_HOST is set.
# EMAIL_BACKEND=smtp
# Hosts that block SMTP ports (Render free): EMAIL_BACKEND=brevo and a Brevo API key (D125).
# BREVO_API_KEY=CHANGE_ME
# EMAIL_FROM=Clinic AI Assistant <no-reply@clinic.example>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=CHANGE_ME
# SMTP_PASSWORD=CHANGE_ME
# SMTP_STARTTLS=true

# Clinic AI Assistant (D96, Gemini D100). Off unless provider, model and key are all set.
# Keys stay on the server and are never sent to the browser.
# AI_ENABLED=true
# AI_PROVIDER=gemini                 # none | gemini | anthropic | openai_compatible
# GEMINI_API_KEY=CHANGE_ME           # from Google AI Studio (aistudio.google.com)
# GEMINI_MODEL=gemini-3.5-flash-lite # used exactly as set: no automatic fallback to another (paid) model.
#                                    # Check it first: python -m app.cli.ai_check
# GEMINI_THINKING_LEVEL=             # optional, e.g. low; empty = the model's default
# Other providers:
# AI_MODEL=claude-sonnet-5-5         # anthropic / openai_compatible model id
# ANTHROPIC_API_KEY=CHANGE_ME        # anthropic: from console.anthropic.com
# AI_API_KEY=CHANGE_ME               # openai_compatible (or any provider)
# AI_BASE_URL=https://api.groq.com/openai/v1   # openai_compatible only
#
# Cost controls (free tier friendly). 0 disables a limit.
# AI_MAX_OUTPUT_TOKENS=600
# AI_MAX_TOOL_CALLS=3                # model round trips per message (alias of AI_MAX_TOOL_STEPS)
# AI_MAX_HISTORY_MESSAGES=12         # earlier messages sent with each request
# AI_REQUEST_TIMEOUT_SECONDS=30      # alias of AI_TIMEOUT_SECONDS
# AI_DAILY_REQUEST_LIMIT=20          # per user, per clinic day
# AI_RATE_LIMIT_PER_MINUTE=5         # per user
# AI_GLOBAL_DAILY_REQUEST_LIMIT=500  # whole server; keep below your project's daily quota
# AI_GLOBAL_RATE_LIMIT_PER_MINUTE=15 # whole server; keep below your project's per-minute quota
# AI_LOG_TOKEN_USAGE=true            # token counts only, never prompts or answers
# AI_ACTION_TTL_MINUTES=15           # a proposed booking/cancellation/move expires after this
#
# Patient health information (the user's appointments, patient search, uploaded
# documents) reaches the provider ONLY when true. Keep false for free tiers
# (their data may be used to improve the provider's products); true only with
# synthetic test data or a provider approved for patient data.
# AI_PHI_ALLOWED=false
# AI_ALLOW_SYNTHETIC_DOCUMENTS=false     # dev: documents that declare themselves synthetic may be explained by the model
# AI_ENABLE_MEDICAL_DOCUMENT_UPLOAD=false   # also needs AI_PHI_ALLOWED=true
# AI_MAX_FILE_BYTES=10485760
# AI_MAX_FILES_PER_MESSAGE=5
# AI_DOCUMENT_RETENTION_DAYS=30      # python -m scripts.purge_ai_documents
# AI_CONVERSATION_RETENTION_DAYS=90  # same script; conversations untouched this long

# Live updates over WebSockets (D122, docs/ARCHITECTURE.md §14). Defaults shown.
# The socket accepts browser origins from WS_ALLOWED_ORIGINS, or CORS_ORIGINS when
# empty (development accepts any origin; a one-time ticket is always required).
# REALTIME_ENABLED=true
# WS_ALLOWED_ORIGINS=
# WS_MAX_CONNECTIONS_PER_USER=5
# WS_MAX_CONNECTIONS=500

# Forgot password (D126, docs/PASSWORD_RESET.md). Links go to FRONTEND_BASE_URL/reset-password and
# are sent at once through the email backend above. Defaults shown; usually nothing to set.
# PASSWORD_RESET_TOKEN_MINUTES=15
# PASSWORD_RESET_REQUESTS_PER_MINUTE=5     # per client IP, POST /auth/forgot-password
# PASSWORD_RESET_ATTEMPTS_PER_MINUTE=10    # per client IP, the reset endpoints
# PASSWORD_RESET_RESEND_SECONDS=60         # per account, counted in the database
# PASSWORD_RESET_MAX_PER_HOUR=5            # per account, counted in the database
