# Copy to .env and fill in real values. Never commit .env.

# development | staging | production
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/clinic_ai
# Logs every SQL statement with its parameters. Keep false wherever real data exists.
SQL_ECHO=false

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Comma-separated list of exact frontend origins. "*" is rejected.
CORS_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO

# Optional: database used by pytest. Defaults to DATABASE_URL's name + "_test".
# The test suite refuses to run against the DATABASE_URL database itself.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/clinic_ai_test
